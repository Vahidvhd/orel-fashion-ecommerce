# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://onlineshop:onlineshop@localhost:5432/onlineshop

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage (leave empty for local media in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_CLOUDINARY=False

# Stripe (test mode)
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=

# Geo / country restriction
GEOIP_DEFAULT_COUNTRY=GB
ALLOWED_AUTH_COUNTRIES=IR,GB

# Email (verification abstraction)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@maisonatelier.com

# SMS abstraction (console in dev)
SMS_BACKEND=console

# Rate limiting
RATELIMIT_ENABLE=True

# Brand
BRAND_NAME=Orel Fashion
